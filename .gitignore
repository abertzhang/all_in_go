# ===================== Go 构建产物 =====================
# 编译生成的可执行文件 / 动态库
*.exe
*.exe~
*.dll
*.so
*.dylib

# 测试与覆盖率产物
*.test
*.out
*.cover

# 编译输出目录
/bin/
/dist/
/build/

# Go workspace（多模块本地开发用，通常不入库）
go.work
go.work.sum

# 依赖目录（如曾用 vendor 模式）
vendor/

# ===================== 日志 / 临时产物 =====================
*.log
gin.log
output.txt
test.txt

# ===================== macOS 系统文件 =====================
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd/

# ===================== 编辑器 / IDE =====================
.idea/
.vscode/
*.swp
*.swo
*~

# ===================== 本地环境变量 =====================
.env
.env.local
